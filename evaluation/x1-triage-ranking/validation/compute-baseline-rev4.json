  "executed_driver": "import sys,json,time,inspect,hashlib,platform\nfrom pathlib import Path\nsys.path.insert(0,sys.argv[1])\nimport compute_benchmark as b\nimport ranking\nout=Path(sys.argv[1])/'compute-baseline-rev4.json'\nif out.exists(): raise FileExistsError(out)\nstarted=time.perf_counter()\nsources={str(p):b.digest(p) for p in (Path(b.__file__),Path(ranking.__file__))}\nrows=[]\nfor L in (40,400):\n for missing in (False,True):\n  wall,cpu=time.perf_counter(),time.process_time()\n  frame,selected=b.trial_frame(L,missing,0)\n  kwargs={'replicates':1999,'seed':b.seed_for('bootstrap',L,missing,0),'include_conditional':False}\n  if 'method' in inspect.signature(ranking.analyse).parameters:kwargs['method']='percentile'\n  result=ranking.analyse(frame,**kwargs)\n  rows.append({'L':L,'missing_labels':missing,'elapsed_seconds':time.perf_counter()-wall,'cpu_seconds':time.process_time()-cpu,'result':result})\n  print(json.dumps(rows[-1]),flush=True)\nresult={'schema':'x1-compute-baseline/rev4','synthetic_only':True,'binding_oc_gate':False,'method':'percentile','replicates':1999,'workers':1,'python_version':platform.python_version(),'source_sha256':sources,'executed_driver':Path(sys.argv[2]).read_text() if False else None,'cells':rows,'elapsed_seconds':time.perf_counter()-started}\nresult['executed_driver']=sys.argv[2]\nwith out.open('x') as f:json.dump(result,f,indent=2,sort_keys=True);f.write('\\n')\n",
