+// Keep all path and identity-bearing values unchanged so Clawpatch stable IDs
+// remain canonical; redact only provider-authored descriptive metadata before
+// it can become a feature record.
+function sanitizeAgentMapOutput(output: AgentMapOutput): AgentMapOutput {
+  return {
+    features: output.features.map((feature) => ({
+      ...feature,
+      title: sanitizeSensitiveText(feature.title),
+      summary: sanitizeSensitiveText(feature.summary),
+      entrypoints: feature.entrypoints.map((entrypoint) => ({
+        ...entrypoint,
+        symbol: sanitizeOptionalText(entrypoint.symbol),
+        route: sanitizeOptionalText(entrypoint.route),
+        command: sanitizeOptionalText(entrypoint.command),
+      })),
+      ownedFiles: feature.ownedFiles.map((file) => ({
+        ...file,
+        reason: sanitizeSensitiveText(file.reason),
+      })),
+      contextFiles: feature.contextFiles.map((file) => ({
+        ...file,
+        reason: sanitizeSensitiveText(file.reason),
+      })),
+      tests: feature.tests.map((test) => ({
+        ...test,
+        command: sanitizeOptionalText(test.command),
+      })),
+      tags: feature.tags.map(sanitizeSensitiveText),
+      reason: sanitizeSensitiveText(feature.reason),
+    })),
+    notes: output.notes.map(sanitizeSensitiveText),
+  };
+}
+
+function sanitizeOptionalText(value: string | null): string | null {
+  return value === null ? null : sanitizeSensitiveText(value);
+}
