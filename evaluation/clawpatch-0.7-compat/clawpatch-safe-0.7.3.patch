+// sanitizeSensitiveText redacts credential-shaped values before any provider
+// prompt, output, error, finding, run, or report can be persisted.
+// Redaction preserves line breaks so source evidence line ranges remain valid.
+export function sanitizeSensitiveText(value: string): string {
+  return value
+    .replace(/-----BEGIN [^-]+-----[\s\S]*?-----END [^-]+-----/gu, redactMultilineSecret)
+    .replace(
+      /\b(api[_-]?key|access[_-]?token|auth(?:entication|orization)?|client[_-]?secret|password|passwd|private[_-]?key|secret|session[_-]?token)\b(\s*[:=]\s*)(?:"(?:\\.|[^"\\\r\n])*"|'(?:\\.|[^'\\\r\n])*'|[^\s,;)}\]]+)/giu,
+      (_match, name: string, separator: string) => `${name}${separator}[SCOUT_REDACTED_SECRET]`,
+    )
+    .replace(/\bBearer\s+[A-Za-z0-9._~+/=-]+\b/giu, "Bearer [SCOUT_REDACTED_SECRET]")
+    .replace(/\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b/gu, "[SCOUT_REDACTED_JWT]")
+    .replace(/\bgh[pousr]_[A-Za-z0-9_]{20,}\b/gu, "[SCOUT_REDACTED_TOKEN]")
+    .replace(/\bsk-[A-Za-z0-9_-]{16,}\b/gu, "[SCOUT_REDACTED_TOKEN]")
+    .replace(/\bAKIA[0-9A-Z]{16}\b/gu, "[SCOUT_REDACTED_AWS_KEY]");
+}
+
+// sanitizeProviderReviewOutput applies the same redaction before validated
+// findings, dropped-finding samples, and provider diagnostics reach state.
+export function sanitizeProviderReviewOutput<T>(value: T): T {
+  if (typeof value === "string") {
+    return sanitizeSensitiveText(value) as T;
+  }
+  if (Array.isArray(value)) {
+    return value.map((item) => sanitizeProviderReviewOutput(item)) as T;
+  }
+  if (value !== null && typeof value === "object") {
+    return Object.fromEntries(
+      Object.entries(value as Record<string, unknown>).map(([key, item]) => [
+        key,
+        sanitizeProviderReviewOutput(item),
+      ]),
+    ) as T;
+  }
+  return value;
+}
+
+function redactMultilineSecret(value: string): string {
+  return `[SCOUT_REDACTED_SECRET]${value.replace(/[^\r\n]/gu, "")}`;
+}
