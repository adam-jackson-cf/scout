# Scout toolchain pins: the single source of truth for external tool versions.
# Sourced by scripts/bootstrap-tools.sh, scripts/build-clawpatch.sh and the GitHub workflows.
# Clawpatch's revision is the gitlink of the third_party/clawpatch submodule, not a value here.
# Go code keeps its own constants (they feed tool digests); internal/toolchain tests enforce parity.
# Changing a scanner or Clawpatch pin is a tool upgrade: it needs a compatibility review (design §4, R9).
# Format: KEY=VALUE, no quotes, no spaces, no shell expansion.

GO_VERSION=1.25.6
NODE_VERSION=22.18.0
PNPM_VERSION=11.25.0
PYTHON_VERSION=3.11.11
UV_VERSION=0.13.5
GITLEAKS_VERSION=8.30.1
SEMGREP_VERSION=1.100.0
RUFF_VERSION=0.15.8
LIZARD_VERSION=1.21.7
JSCPD_VERSION=4.0.8
CLAWPATCH_VERSION=0.7.3
