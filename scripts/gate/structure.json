{
  "layout_reasons": {
    "internal": "Existing Go packages own colocated tests; nested orderflip, thresholds and statetest are existing distinct owners.",
    "scripts/gate": "The repository gate owns its Python modules, Go parser and process-boundary tests.",
    "internal/association/testdata": "Versioned replay evidence and its generator stay beside the association tests that consume them.",
    "internal/analyzers/rules": "Embedded scanner assets retain their runtime paths; moving embedded data is outside this naming change.",
    "docs": "Contributor references and feature catalogues use kebab-case; governed documents retain their established names.",
    "toolchain": "Pinned dependency metadata uses ecosystem-defined filenames.",
    ".agents/skills": "Skill catalogues retain their standard SKILL.md entry point."
  },
  "banned_folders": ["common", "compat", "fallback", "helpers", "legacy", "manager", "misc", "new", "old", "stuff", "temp", "utils"],
  "destinations": {
    "scripts": "scripts/gate",
    "docs": "docs",
    "toolchain": "toolchain"
  },
  "shell_sources": {
    "prefixes": {
      "$repo/": "",
      "${repo}/": "",
      "$src/": "",
      "$script_dir/": "{parent}/",
      "$(dirname \"$0\")/": "{parent}/"
    },
    "external": {
      ".tools/activate": "Generated activation script belongs to the pinned tool environment, not owned source."
    }
  },
  "naming": {
    "paths": {
      ".py": "[a-z_][a-z0-9_]*",
      ".go": "[a-z][a-z0-9_]*",
      ".sh": "[a-z][a-z0-9]*(?:-[a-z0-9]+)*"
    },
    "python_function": "_*[a-z][a-z0-9_]*",
    "python_class": "[A-Z][A-Za-z0-9]*",
    "python_variable": "(?:_*[a-z][a-z0-9_]*|_*[A-Z][A-Z0-9_]*)",
    "go_symbol": "[A-Za-z][A-Za-z0-9_]*",
    "python_protocol_methods": ["setUp", "tearDown", "setUpClass", "tearDownClass", "visit_ClassDef", "visit_FunctionDef", "visit_AsyncFunctionDef", "visit_Call", "visit_Subscript", "visit_For", "visit_AsyncFor", "visit_While", "visit_ListComp", "visit_SetComp", "visit_DictComp", "visit_GeneratorExp"],
    "test_tokens": "(?i)(?:issue[0-9]+|ticket[0-9]+|[a-z]+-[0-9]+|v[0-9]+|[0-9]{8}|[0-9]{4}-[0-9]{2}-[0-9]{2})",
    "asset": "[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*",
    "standard_names": ["README.md", "CONTRIBUTING.md", "CHANGELOG.md", "HANDOFF.md", "CLAUDE.md", "AGENTS.md", "SKILL.md", "replay-README.md", "terra-README.md"]
  },
  "test_layout": {
    "go_pattern": "[a-z][a-z0-9_]*_test\\.go",
    "python_pattern": "test_[a-z][a-z0-9_]*\\.py",
    "python_owners": {
      "scripts/gate": {"owner": "scripts/gate", "tier": "seam"}
    },
    "fixture_folders": ["fixtures", "testdata"],
    "fixture_home": "testdata",
    "support_folders": ["test_support", "support", "statetest"],
    "support_home": "internal/state/statetest",
    "support_packages": {"statetest": "internal/state/statetest"}
  },
  "owned_paths": [
    "[^/\\\\\\x00]+",
    "cmd/scout/[^/\\\\\\x00]+",
    "internal/analyzers/[^/\\\\\\x00]+",
    "internal/areas/[^/\\\\\\x00]+",
    "internal/artifacts/[^/\\\\\\x00]+",
    "internal/association/[^/\\\\\\x00]+",
    "internal/baseline/[^/\\\\\\x00]+",
    "internal/clawpatch/[^/\\\\\\x00]+",
    "internal/contextual/[^/\\\\\\x00]+",
    "internal/decisions/[^/\\\\\\x00]+",
    "internal/decisions/orderflip/[^/\\\\\\x00]+",
    "internal/decisions/thresholds/[^/\\\\\\x00]+",
    "internal/domain/[^/\\\\\\x00]+",
    "internal/engine/[^/\\\\\\x00]+",
    "internal/eval/[^/\\\\\\x00]+",
    "internal/guardrails/[^/\\\\\\x00]+",
    "internal/history/[^/\\\\\\x00]+",
    "internal/importgraph/[^/\\\\\\x00]+",
    "internal/inventory/[^/\\\\\\x00]+",
    "internal/issues/[^/\\\\\\x00]+",
    "internal/measures/[^/\\\\\\x00]+",
    "internal/modelcli/[^/\\\\\\x00]+",
    "internal/policy/[^/\\\\\\x00]+",
    "internal/prmeta/[^/\\\\\\x00]+",
    "internal/redact/[^/\\\\\\x00]+",
    "internal/sandbox/[^/\\\\\\x00]+",
    "internal/shadow/[^/\\\\\\x00]+",
    "internal/state/[^/\\\\\\x00]+",
    "internal/state/statetest/[^/\\\\\\x00]+",
    "internal/toolchain/[^/\\\\\\x00]+",
    "internal/web/[^/\\\\\\x00]+",
    "docs/[^/\\\\\\x00]+",
    "docs/(?:features|references)/[^/\\\\\\x00]+",
    "scripts/[^/\\\\\\x00]+",
    "scripts/gate/[^/\\\\\\x00]+",
    "toolchain/[^/\\\\\\x00]+",
    "toolchain/node/[^/\\\\\\x00]+",
    "\\.github/workflows/[^/\\\\\\x00]+",
    "\\.agents/skills/[a-z-]+/[^/\\\\\\x00]+",
    "\\.claude/skills",
    "\\.githooks/[^/\\\\\\x00]+",
    "internal/[^/]+/testdata/[^/\\\\\\x00]+",
    "\\.scout/[^/]+",
    "internal/analyzers/rules/(?:performance|security)/[^/]+",
    "internal/association/testdata/[^/]+",
    "internal/association/testdata/gen/[^/]+"
  ],
  "python": {
    "maintained_roots": ["scripts/gate/", "internal/association/testdata/gen/"],
    "maintained_packages": ["scripts/gate/", "internal/association/testdata/gen/"],
    "script_roots": [],
    "script_names": [],
    "script_name_exceptions": [],
    "test_roots": ["scripts/gate/"],
    "test_groups": {"seam": ["scripts/gate/test_*.py"]},
    "generic_name_allowlist": [],
    "skill_roots": [],
    "non_package_dirs": [],
    "class_limits": {"max_lines": 700, "max_public_methods": 20, "max_init_args": 8, "max_instance_attributes": 12},
    "analyzer_roots": [],
    "analyzer_bases": [],
    "analyzer_entrypoints": {},
    "analyzer_like_roots": [],
    "ownership_markers": [],
    "analyzer_scope_reason": "Scout analyzers are Go packages. Python owns contributor gate orchestration and a fixture generator, not product analyzers.",
    "subprocess_wrappers": {
      "scripts/gate/run.py": ["run"],
      "scripts/gate/inventory.py": ["repository_files"],
      "scripts/gate/python.py": ["run"],
      "scripts/gate/typing_policy.py": ["_git"],
      "scripts/gate/infrastructure.py": ["run"],
      "scripts/gate/tests.py": ["run"],
      "scripts/gate/test_inventory.py": ["GateFixture.__init__", "GateFixture.run"],
      "scripts/gate/test_structure_naming.py": [],
      "scripts/gate/test_python_policy.py": []
    },
    "dynamic_import_adapters": ["internal/association/testdata/gen/gen_parity.py"],
    "dynamic_import_reason": "The fixture generator loads signed historical pilot modules through load(); it does not modify those modules.",
    "contract_files": ["scripts/gate/python.py", "scripts/gate/inventory.py"],
    "contract_scope_reason": "Gate subprocess and inventory entry points use concrete contracts; the historical fixture generator consumes heterogeneous JSON and dynamically loaded historical modules.",
    "mypy_overrides": {"lizard": "The pinned lizard distribution has no py.typed or published stub package; follow_untyped_imports checks its installed source."},
    "ruff_approvals": {}
  },
  "dependencies": {
