{
  "kind": "ruff-config",
  "config": {
    "line-length": 88,
    "target-version": "invalid",
    "fix": false,
    "output-format": "full",
    "respect-gitignore": true,
    "preview": true,
    "exclude": [
      "evaluation",
      ".tools",
      "scripts/guardrails/fixtures",
      "scripts/guardrails/vendor",
      ".agent",
      ".agents",
      ".build",
      ".enaible",
      ".git",
      ".tox",
      ".venv",
      "venv",
      "__pycache__",
      "*.egg-info",
      "build",
      "dist",
      "docs/reference",
      "migrations",
      "node_modules",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "tools/enaible/.venv",
      "tests/fixtures/"
    ],
    "lint": {
      "select": [
        "E",
        "W",
        "F",
        "I",
        "B",
        "C4",
        "C901",
        "UP",
        "SIM",
        "PT",
        "PGH",
        "A",
        "D",
        "N",
        "PLR0904",
        "PLR0911",
        "PLR0912",
        "PLR0913",
        "PLR0914",
        "PLR0915",
        "PLR0917"
      ],
      "ignore": [
        "E501",
        "D100",
        "D101",
        "D102",
        "D103",
        "D104",
        "D105",
        "D107",
        "B006",
        "B008",
        "A005"
      ],
      "per-file-ignores": {
        "__init__.py": [
          "F401",
          "F403",
          "D104"
        ],
        "test_*.py": [
          "D",
          "S101",
          "PLR2004"
        ],
        "**/tests/**": [
          "D",
          "S101",
          "PLR2004"
        ],
        "conftest.py": [
          "D"
        ],
        "setup.py": [
          "D"
        ]
      },
      "isort": {
        "known-first-party": [],
        "force-single-line": false,
        "combine-as-imports": true,
        "split-on-trailing-comma": true
      },
      "mccabe": {
        "max-complexity": 10
      },
      "pylint": {
        "max-args": 5,
        "max-branches": 12,
        "max-locals": 15,
        "max-positional-args": 5,
        "max-public-methods": 20,
        "max-returns": 6,
        "max-statements": 50
      },
      "pydocstyle": {
        "convention": "numpy"
      }
    },
    "format": {
      "quote-style": "double",
      "indent-style": "space",
      "line-ending": "auto",
      "docstring-code-format": true
    }
  },
  "rule": "RUFF.SETTING.target-version",
  "target": {
    "maintained_import_roots": [
      "scripts/guardrails/python",
      "scripts/guardrails"
    ],
    "maintained_packages": [
      "scripts.guardrails",
      "scripts.guardrails.python"
    ],
    "maintained_sources": [
      "scripts/guardrails/gate.py",
      "scripts/guardrails/python/check.py"
    ],
    "supported_python_versions": [
      "3.11",
      "3.12"
    ],
    "exclusion_rationales": {
      "evaluation": "frozen non-maintained studies",
      ".tools": "generated tool environment",
      "scripts/guardrails/fixtures": "checker input data, not maintained source",
      "scripts/guardrails/vendor": "byte-preserved third-party source"
    },
    "module_override_evidence": {
      "lizard": {
        "kind": "missing-stub",
        "evidence": "pinned distribution has no py.typed or bundled stubs"
      }
    },
    "canonical_test_groups": {
      "unit": "T1",
      "seams": "T2",
      "integration": "T2",
      "support": "support",
      "fixtures": "data"
    },
    "maintained_first_party_names": [
      "scripts",
      "internal"
    ]
  }
}
