{
  "rule": "GATE.pre-commit",
  "bad": false,
  "config": {
    "schemaVersion": 2,
    "checks": {
      "commit": [
        "python",
        "check.py",
        "commit"
      ],
      "ci": [
        "python",
        "check.py",
        "full"
      ]
    },
    "ci": {
      "requiredContext": "gate",
      "runner": "github-actions"
    },
    "pathCheck": [
      "python",
      "check.py",
      "path"
    ],
    "pathCheckTimeoutMs": 10000,
    "testGlobs": [
      "**/*_test.go"
    ],
    "agentMerge": "allowed"
  },
  "ci_argv": [
    "python",
    "check.py",
    "full"
  ],
  "hook_installed": false
}
