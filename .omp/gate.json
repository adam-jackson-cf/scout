{
  "schemaVersion": 2,
  "checks": {
    "commit": [
      "bash",
      "scripts/gate.sh",
      "commit"
    ],
    "ci": [
      "bash",
      "scripts/gate.sh",
      "ci"
    ]
  },
  "pathCheck": [
    "bash",
    "scripts/gate.sh",
    "path"
  ],
  "pathCheckTimeoutMs": 10000,
  "testGlobs": [
    "**/*_test.go",
    "scripts/guardrails/**/fixtures/**",
    "scripts/guardrails/**/canary.py",
    "scripts/guardrails/**/canaries.py",
    "scripts/guardrails/hook-check.py"
  ],
  "agentMerge": "allowed",
  "ciHost": "github"
}
