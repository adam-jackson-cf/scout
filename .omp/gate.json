{
  "schemaVersion": 2,
  "checks": {
    "commit": [
      "bash",
      "scripts/gate.sh",
      "commit"
    ],
    "ci": [
      "bash",
      "scripts/gate.sh",
      "ci"
    ]
  },
  "pathCheck": [
    "bash",
    "scripts/gate.sh",
    "path"
  ],
  "pathCheckTimeoutMs": 10000,
  "testGlobs": [
    "**/*_test.go",
    "scripts/guardrails/**/fixtures/**",
    "scripts/guardrails/**/canary.py",
    "scripts/guardrails/**/canaries.py",
    "scripts/guardrails/hook-check.py"
  ],
  "sensitive": [
    ".github/",
    ".omp/",
    ".githooks/",
    ".scout/",
    ".agents/",
    "scripts/guardrails/",
    "toolchain/",
    "bootstrap-tools.sh",
    "gate.sh",
    "build-clawpatch.sh",
    "scout-design.html",
    "docs/adrs/",
    "jev-adapter-audit.md",
    "evaluation/",
    "third_party/",
    "research-ledger.md",
    "hypothesis-ledger.md",
    "CLAUDE.md",
    ".gitleaksignore",
    ".gitmodules",
    "AGENTS.md",
    "ruff.toml",
    "mypy.ini",
    ".prettierrc",
    ".prettierignore",
    "go.mod",
    "go.sum"
  ],
  "agentMerge": "allowed",
  "ciHost": "github"
}
